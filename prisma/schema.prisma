// =============================================
// ClasesYa - Schema de base de datos
// =============================================

generator client {
  provider = "prisma-client-js"
  // "native" para el desarrollo en Windows; el musl con OpenSSL 3 es el de la
  // imagen Alpine de Docker (sin él, el motor no se encuentra en tiempo de ejecución).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- ENUMS ----

// Roles de usuario en la plataforma
enum Rol {
  PROFESOR
  ESTUDIANTE
  ADMIN
  MODERADOR
}

// Modalidad de la clase
enum Modalidad {
  PRESENCIAL
  VIRTUAL
  AMBOS
}

// Estado de una reserva
enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

// Estado de un pago
enum EstadoPago {
  PENDIENTE
  COMPLETADO
  FALLIDO
  REEMBOLSADO
}

// Método de pago. Son los canales reales del mercado boliviano: no hay
// pasarelas de tarjeta ni PayPal operando para comercios del país.
enum MetodoPago {
  EFECTIVO
  QR
  TRANSFERENCIA
  TIGO_MONEY
}

// Situación de una inscripción a un curso
enum EstadoInscripcion {
  PENDIENTE_PAGO
  ACTIVA
  RECHAZADA
}

// Tipo de notificación
enum TipoNotificacion {
  RESERVA_NUEVA
  RESERVA_CONFIRMADA
  RESERVA_CANCELADA
  RESERVA_COMPLETADA
  RESENA_NUEVA
  MENSAJE_NUEVO
  PAGO_RECIBIDO
  // Un pago rechazado no es una reserva cancelada: sin su propio tipo, el aviso
  // llega con el icono y el color equivocados.
  PAGO_RECHAZADO
  PAGO_ARBITRADO
  PERFIL_VERIFICADO
  ENTREGA_CALIFICADA
  // El aula: sin estos, publicar una tarea o subir material no avisaba a nadie
  TAREA_NUEVA
  MATERIAL_NUEVO
  ENTREGA_RECIBIDA
}

// ---- MODELOS ----

// Usuarios de la plataforma (profesores y estudiantes)
model Usuario {
  id        String   @id @default(uuid())
  nombre    String
  email     String   @unique
  password  String
  rol       Rol
  foto      String?
  // Identificador en Cloudinary de la foto, para poder reemplazarla o borrarla
  fotoPublicId String? @map("foto_public_id")
  telefono  String?
  bio       String?  @db.Text
  ubicacion String?
  activo    Boolean  @default(true)
  // Verificación manual del profesor por un administrador (insignia de confianza)
  verificado   Boolean   @default(false)
  verificadoAt DateTime? @map("verificado_at")
  // Última vez que el usuario inició sesión (seguimiento de actividad)
  ultimoAcceso DateTime? @map("ultimo_acceso")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones: un profesor tiene servicios y disponibilidad
  servicios      Servicio[]
  disponibilidad Disponibilidad[]
  // Un estudiante tiene reservas
  reservas       Reserva[]
  // Notificaciones del usuario
  notificaciones Notificacion[]
  // Mensajes enviados y recibidos
  mensajesEnviados  Mensaje[] @relation("MensajesEnviados")
  mensajesRecibidos Mensaje[] @relation("MensajesRecibidos")
  // Aula virtual: cursos que imparte (profesor) e inscripciones (estudiante)
  cursos        Curso[]
  inscripciones Inscripcion[]
  entregas      Entrega[]
  // Datos con los que el profesor recibe los pagos
  datosCobro    DatosCobro?

  @@map("usuarios")
}

// Categorías para organizar los servicios
model Categoria {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  icono       String?  // Nombre del icono (ej: "math", "music", "code")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relaciones
  servicios Servicio[]

  @@map("categorias")
}

// Servicios de enseñanza que ofrecen los profesores
model Servicio {
  id           String    @id @default(uuid())
  profesorId   String    @map("profesor_id")
  categoriaId  String?   @map("categoria_id")
  materia      String
  descripcion  String    @db.Text
  precioHora   Decimal   @map("precio_hora") @db.Decimal(10, 2)
  modalidad    Modalidad
  nivel        String?   // Ej: "Primaria", "Secundaria", "Universitario"
  duracionMin  Int       @default(60) @map("duracion_min")
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relaciones
  profesor  Usuario    @relation(fields: [profesorId], references: [id], onDelete: Cascade)
  categoria Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  reservas  Reserva[]

  @@index([profesorId])
  @@index([categoriaId])
  @@index([materia])
  @@map("servicios")
}

// Disponibilidad horaria de los profesores
model Disponibilidad {
  id         String @id @default(uuid())
  profesorId String @map("profesor_id")
  diaSemana  Int    @map("dia_semana") // 0=Lunes, 1=Martes, ..., 6=Domingo
  horaInicio String @map("hora_inicio") // Formato "HH:mm"
  horaFin    String @map("hora_fin")    // Formato "HH:mm"

  // Relaciones
  profesor Usuario @relation(fields: [profesorId], references: [id], onDelete: Cascade)

  @@index([profesorId])
  @@map("disponibilidad")
}

// Reservas de clases
model Reserva {
  id           String        @id @default(uuid())
  servicioId   String        @map("servicio_id")
  estudianteId String        @map("estudiante_id")
  fecha        DateTime
  horaInicio   String        @map("hora_inicio") // "HH:mm"
  horaFin      String        @map("hora_fin")    // "HH:mm"
  estado       EstadoReserva @default(PENDIENTE)
  notas        String?       @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relaciones
  servicio   Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  estudiante Usuario  @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  resena     Resena?  // Una reserva puede tener máximo una reseña
  pago       Pago?    // Una reserva puede tener máximo un pago

  @@index([servicioId])
  @@index([estudianteId])
  @@index([fecha])
  @@map("reservas")
}

// Reseñas de clases completadas
model Resena {
  id           String   @id @default(uuid())
  reservaId    String   @unique @map("reserva_id")
  calificacion Int      // 1 a 5 estrellas
  comentario   String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  // Relaciones
  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)

  @@map("resenas")
}

// Pagos de reservas
// Registro de un pago. La plataforma no mueve dinero: guarda el comprobante que
// sube el estudiante y la decisión del profesor al verificarlo en su cuenta.
// Un pago pertenece a una reserva (clase particular) o a una inscripción
// (curso); exactamente uno de los dos, lo que se garantiza en la capa de API.
model Pago {
  id            String     @id @default(uuid())
  reservaId     String?    @unique @map("reserva_id")
  inscripcionId String?    @unique @map("inscripcion_id")
  monto         Decimal    @db.Decimal(10, 2)
  metodoPago    MetodoPago @map("metodo_pago")
  estado        EstadoPago @default(PENDIENTE)
  referencia    String?    // Número de transacción indicado por el estudiante

  // Comprobante que sube el estudiante (imagen o PDF en Cloudinary)
  comprobanteUrl      String? @map("comprobante_url")
  comprobantePublicId String? @map("comprobante_public_id")
  comprobanteTipo     String? @map("comprobante_tipo") // image/raw, para el borrado

  // Revisión por parte del profesor
  revisadoEn    DateTime? @map("revisado_en")
  motivoRechazo String?   @db.Text @map("motivo_rechazo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  reserva     Reserva?     @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  inscripcion Inscripcion? @relation(fields: [inscripcionId], references: [id], onDelete: Cascade)

  @@index([estado])
  @@map("pagos")
}

// Notificaciones del sistema
model Notificacion {
  id        String           @id @default(uuid())
  usuarioId String           @map("usuario_id")
  tipo      TipoNotificacion
  mensaje   String
  leida     Boolean          @default(false)
  enlace    String?          // URL relativa a donde lleva la notificación
  createdAt DateTime         @default(now()) @map("created_at")

  // Relaciones
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([leida])
  @@map("notificaciones")
}

// ---- AUDITORÍA ----

// Acciones administrativas que quedan registradas
enum AccionAuditoria {
  PROFESOR_VERIFICADO
  PROFESOR_VERIFICACION_REVOCADA
  USUARIO_ACTIVADO
  USUARIO_DESACTIVADO
  ROL_CAMBIADO
  // Arbitraje: el administrador revierte la decisión del profesor sobre un pago
  PAGO_ARBITRADO
}

// Registro de acciones sensibles. A propósito NO tiene relaciones con Usuario:
// los datos del actor y del objetivo se guardan desnormalizados para que el
// historial sobreviva aunque la cuenta implicada se elimine.
model RegistroAuditoria {
  id             String          @id @default(uuid())
  actorId        String?         @map("actor_id")
  actorNombre    String          @map("actor_nombre")
  accion         AccionAuditoria
  objetivoId     String?         @map("objetivo_id")
  objetivoNombre String?         @map("objetivo_nombre")
  detalle        String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorId])
  @@map("registros_auditoria")
}

// ---- COBROS ----

// Datos con los que un profesor recibe los pagos de sus cursos y clases.
// La plataforma no procesa dinero: solo muestra estos datos al estudiante y
// deja constancia del pago. Por eso conviven varios canales del mercado
// boliviano (QR interoperable, transferencia bancaria y billetera móvil).
model DatosCobro {
  id         String @id @default(uuid())
  profesorId String @unique @map("profesor_id")

  // QR bancario: la vía más extendida en Bolivia
  qrUrl      String? @map("qr_url")
  qrPublicId String? @map("qr_public_id")

  // Transferencia bancaria
  banco        String?
  titular      String?
  numeroCuenta String? @map("numero_cuenta")

  // Billetera móvil
  tigoMoney String? @map("tigo_money")

  // Indicaciones libres para el estudiante (p. ej. "pon tu nombre en el detalle")
  instrucciones String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profesor Usuario @relation(fields: [profesorId], references: [id], onDelete: Cascade)

  @@map("datos_cobro")
}

// ---- AULA VIRTUAL ----

// Curso creado por un profesor (contenedor de material y estudiantes inscritos)
model Curso {
  id          String   @id @default(uuid())
  profesorId  String   @map("profesor_id")
  titulo      String
  descripcion String   @db.Text
  // Precio en bolivianos. Cero significa que el curso es gratuito.
  precio      Decimal  @default(0) @db.Decimal(10, 2)
  // Vigencia del curso. Si no se indican, el curso está siempre abierto.
  fechaInicio DateTime? @map("fecha_inicio")
  fechaFin    DateTime? @map("fecha_fin")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relaciones
  profesor      Usuario       @relation(fields: [profesorId], references: [id], onDelete: Cascade)
  inscripciones Inscripcion[]
  materiales    Material[]
  tareas        Tarea[]

  @@index([profesorId])
  @@map("cursos")
}

// Inscripción de un estudiante a un curso
model Inscripcion {
  id           String   @id @default(uuid())
  cursoId      String   @map("curso_id")
  estudianteId String   @map("estudiante_id")
  // Un curso gratuito queda ACTIVA al instante; uno de pago espera a que el
  // profesor confirme haber recibido el dinero.
  estado       EstadoInscripcion @default(ACTIVA)
  createdAt    DateTime @default(now()) @map("created_at")
  // El default permite añadir la columna sobre inscripciones que ya existían
  // (db push no puede crear una columna obligatoria sin default con datos dentro).
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  // Relaciones
  curso      Curso   @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  estudiante Usuario @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  pago       Pago?

  // Un estudiante no puede inscribirse dos veces al mismo curso
  @@unique([cursoId, estudianteId])
  @@index([estudianteId])
  @@map("inscripciones")
}

// Tarea/actividad asignada dentro de un curso
model Tarea {
  id          String    @id @default(uuid())
  cursoId     String    @map("curso_id")
  titulo      String
  descripcion String    @db.Text
  fechaLimite DateTime? @map("fecha_limite")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relaciones
  curso    Curso     @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  entregas Entrega[]

  @@index([cursoId])
  @@map("tareas")
}

// Entrega de un estudiante para una tarea (con archivo opcional en Cloudinary)
model Entrega {
  id                String    @id @default(uuid())
  tareaId           String    @map("tarea_id")
  estudianteId      String    @map("estudiante_id")
  comentario        String?   @db.Text
  url               String?                          // archivo entregado (Cloudinary)
  publicId          String?   @map("public_id")
  tipoRecurso       String?   @map("tipo_recurso")   // image/video/raw (para el borrado)
  formato           String?
  bytes             Int?
  calificacion      Int?                             // nota 0..100 (la pone el profesor)
  retroalimentacion String?   @db.Text @map("retroalimentacion")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relaciones
  tarea      Tarea   @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  estudiante Usuario @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  // Una entrega por estudiante y tarea
  @@unique([tareaId, estudianteId])
  @@index([estudianteId])
  @@map("entregas")
}

// Material de clase subido por el profesor (almacenado en Cloudinary)
model Material {
  id        String   @id @default(uuid())
  cursoId   String   @map("curso_id")
  titulo    String
  url       String                        // URL de descarga (Cloudinary secure_url)
  publicId  String   @map("public_id")    // Identificador en Cloudinary (para borrado)
  // Tipo con el que Cloudinary lo almacenó (image/video/raw). Es imprescindible
  // para poder eliminarlo después: la API de borrado no acepta "auto".
  tipoRecurso String @default("raw") @map("tipo_recurso")
  formato   String?                        // pdf, xlsx, mp4, ...
  bytes     Int?                           // tamaño del archivo
  createdAt DateTime @default(now()) @map("created_at")

  // Relaciones
  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@index([cursoId])
  @@map("materiales")
}

// Mensajes entre usuarios
model Mensaje {
  id          String   @id @default(uuid())
  emisorId    String   @map("emisor_id")
  receptorId  String   @map("receptor_id")
  contenido   String   @db.Text
  leido       Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relaciones
  emisor   Usuario @relation("MensajesEnviados", fields: [emisorId], references: [id], onDelete: Cascade)
  receptor Usuario @relation("MensajesRecibidos", fields: [receptorId], references: [id], onDelete: Cascade)

  @@index([emisorId])
  @@index([receptorId])
  @@index([leido])
  @@map("mensajes")
}
