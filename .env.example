# =============================================
# ClasesYa - Variables de entorno
# Copia este archivo como .env y completa los valores
# =============================================

# ---- Base de datos ----
# Con Docker Compose el host debe ser "postgres" (nombre del servicio).
# Fuera de Docker, usa "localhost".
DATABASE_URL=postgresql://usuario:password@postgres:5432/clasesya
POSTGRES_USER=usuario
POSTGRES_PASSWORD=password
POSTGRES_DB=clasesya

# ---- Autenticación ----
# Genera un valor seguro con: openssl rand -base64 32
JWT_SECRET=clave_secreta_aqui

# ---- Zona horaria ----
# Mantiene coherente el día calendario de las reservas. Sin esto, los
# contenedores usan UTC y el límite de "hoy" se desplaza.
TZ=America/La_Paz

# ---- Almacenamiento de archivos (aula virtual) ----
# Opcional: sin estos valores la aplicación funciona igual, pero subir material
# o entregas devuelve un aviso de que el almacenamiento no está configurado.
# Se obtienen del panel de https://cloudinary.com (capa gratuita).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Entorno ----
# En "production" la cookie de sesión se marca como segura automáticamente.
NODE_ENV=production
